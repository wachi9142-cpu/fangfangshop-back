# คัดลอกไฟล์นี้เป็น .env แล้วปรับค่าตามต้องการ
#   cp .env.example .env

# ที่อยู่ฐานข้อมูล SQLite (ไฟล์เดียว ไม่ต้องตั้ง DB server)
DATABASE_URL="file:./dev.db"

# พอร์ตของ API
PORT=4000

# คีย์ลับสำหรับเซ็น token ล็อกอิน (เปลี่ยนเป็นค่าสุ่มยาว ๆ ใน production)
AUTH_SECRET="dev-change-me-to-a-long-random-string"

# อายุ token (วินาที) — ค่าเริ่มต้น 7 วัน
AUTH_TOKEN_TTL=604800

# origin ของ frontend ที่อนุญาตให้เรียก API (คั่นด้วย , ได้หลายค่า)
CORS_ORIGIN="http://localhost:3000"
